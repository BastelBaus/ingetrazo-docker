<mxfile host="drawio" agent="ingetrazo-docker">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- docker compose stack -->
        <mxCell id="stack" value="docker compose stack" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#555555;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="270" y="40" width="720" height="640" as="geometry" />
        </mxCell>

        <!-- MCP container -->
        <mxCell id="c_mcp" value="Container: mcp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="660" height="260" as="geometry" />
        </mxCell>
        <mxCell id="itz_mcp" value="&lt;b&gt;IngeTrazo&lt;/b&gt; (Python)&lt;br&gt;headless, --ai-bridge&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Xvfb + Mesa (software OpenGL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="160" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="srv_mcp" value="&lt;b&gt;MCP HTTP server&lt;/b&gt;&lt;br&gt;Streamable HTTP&lt;br&gt;auth: token / OAuth&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;/healthz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="160" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_mcp_bridge" value="AI bridge&lt;br&gt;TCP 127.0.0.1&lt;br&gt;(loopback)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#dae8fc;" edge="1" parent="1" source="itz_mcp" target="srv_mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Viewer container -->
        <mxCell id="c_viewer" value="Container: viewer (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="390" width="660" height="260" as="geometry" />
        </mxCell>
        <mxCell id="itz_viewer" value="&lt;b&gt;IngeTrazo&lt;/b&gt; (Python)&lt;br&gt;headless, read-only&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;renders sheets + views&lt;br&gt;when a file changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="srv_viewer" value="&lt;b&gt;Web server&lt;/b&gt;&lt;br&gt;sheets · views · PDF&lt;br&gt;live reload (SSE)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;login / password&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="460" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_viewer_bridge" value="AI bridge&lt;br&gt;TCP 127.0.0.1&lt;br&gt;(loopback)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#d5e8d4;" edge="1" parent="1" source="itz_viewer" target="srv_viewer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Storage (disk) -->
        <mxCell id="disk" value="&lt;b&gt;Model storage&lt;/b&gt;&lt;br&gt;host folder or volume&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;./data → /data&lt;br&gt;*.igz&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="160" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e_disk_mcp" value="/data&lt;br&gt;read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=12;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="disk" target="itz_mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_disk_viewer" value="/data&lt;br&gt;read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=classic;strokeWidth=2;fontSize=12;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="disk" target="itz_viewer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Outside: clients -->
        <mxCell id="clients" value="&lt;b&gt;MCP clients&lt;/b&gt;&lt;br&gt;Claude Code · claude.ai&lt;br&gt;Cursor · VS Code · …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1070" y="180" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1070" y="490" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_clients" value="HTTP :8765 /mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="srv_mcp" target="clients">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_browser" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="srv_viewer" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="Ports are published on 127.0.0.1 by default. To reach them from elsewhere, put a TLS reverse proxy (Caddy, Traefik, …) in front; OAuth needs a public https URL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="270" y="690" width="720" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
