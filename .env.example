# Copy to .env and adjust. Every value is optional unless noted.

# ---- Image ----------------------------------------------------------------
# Use the published image, or build your own from any IngeTrazo ref:
# INGETRAZO_IMAGE=ghcr.io/bastelbaus/ingetrazo:latest
# INGETRAZO_REPO=https://github.com/ingelibre/ingetrazo
# INGETRAZO_REF=<tag, branch or commit with headless mode>

# ---- Models -----------------------------------------------------------------
# Host folder with your .igz files (mounted at /data in the containers).
INGETRAZO_DATA_DIR=./data
# Document to open at start (relative to the data folder). Empty: none.
INGETRAZO_MODEL=
# Let MCP clients save (save_document). Paths are confined to /data.
INGETRAZO_ALLOW_SAVE=true
# "json" saves plain-JSON .igz (diffable in git); empty: as the app does.
INGETRAZO_SAVE_FORMAT=

# ---- MCP server ---------------------------------------------------------------
# Interface the port is published on. 127.0.0.1 = this machine only;
# 0.0.0.0 = the network (then use token or oauth, and TLS in front).
MCP_BIND=127.0.0.1
MCP_PORT=8765
# none | token | oauth   (run_python executes arbitrary Python in the container)
MCP_AUTH=token
# Required for MCP_AUTH=token, at least 16 characters: openssl rand -hex 32
MCP_TOKEN=
# Public https URL of this server (required for oauth, e.g. behind Caddy).
PUBLIC_URL=
# oauth: the one user who may approve clients, and the allowed redirect URIs
# (comma-separated prefixes; default: claude.ai and claude.com callbacks).
OAUTH_USER=admin
OAUTH_PASSWORD=
OAUTH_REDIRECT_URIS=

# ---- Viewer (docker compose --profile viewer up) ------------------------------
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8080
# Who may see the viewer: local | none | oidc | proxy  (README: "Viewer login")
#   local  one user and password (required: the viewer won't start without it)
#   none   no login at all, on purpose
#   oidc   OpenID Connect (Authentik, Keycloak, ...)
#   proxy  a reverse proxy with forward auth names the user in a header
VIEWER_AUTH_MODE=local
VIEWER_USER=viewer
VIEWER_PASSWORD=
# oidc: the provider's issuer URL, the client, and https://<viewer>/auth/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Optional: default "openid profile email"; members of this group are admins.
OIDC_SCOPES=
OIDC_ADMIN_GROUP=
# proxy: the proxy's address(es)/networks (required), its headers, admin group,
# and where Log out goes (Authentik: /outpost.goauthentik.io/sign_out).
PROXY_TRUSTED_IPS=
PROXY_USER_HEADER=X-authentik-username
PROXY_GROUPS_HEADER=
PROXY_ADMIN_GROUP=
PROXY_LOGOUT_URL=
VIEWER_TITLE=IngeTrazo viewer
VIEWER_SHEET_DPI=120
